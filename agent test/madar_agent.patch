+/* ---------- scheduler (AI agent) ---------- */
+.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+.scheduler { display: grid; gap: 14px; }
+.chat-log { display: grid; gap: 12px; align-content: start; max-height: 62vh; min-height: 220px; overflow-y: auto; padding: 4px; }
+.bubble { max-width: min(760px, 92%); padding: .9em 1.2em; border-radius: 20px; }
+.bubble p { margin: 0; white-space: pre-wrap; }
+.bubble.me { justify-self: end; background: var(--accent); color: #fff; border-end-end-radius: 6px; }
+.bubble.ai { justify-self: start; background: #fff; box-shadow: inset 0 0 0 1.5px var(--line); border-end-start-radius: 6px; display: grid; gap: 10px; }
+.bubble.thinking { color: var(--soft); animation: pulse 1.4s ease-in-out infinite; }
+@keyframes pulse { 50% { opacity: .45; } }
+.steps summary { cursor: pointer; color: var(--soft); font-size: .85em; }
+.steps ol { margin: .4em 0 0; padding-inline-start: 1.4em; color: var(--soft); font-size: .85em; }
+.proposal { display: grid; gap: 6px; padding: .8em 1em; border-radius: 16px; background: var(--panel); box-shadow: inset 0 0 0 1.5px var(--rim); }
+.proposal p { margin: 0; }
+.proposal.applied { box-shadow: inset 0 0 0 1.5px var(--ok); }
+.proposal.rejected { opacity: .6; }
+.impact { margin: 0; padding-inline-start: 1.2em; font-size: .85em; color: var(--soft); }
+.impact .bad { color: var(--err); font-weight: 700; }
+.chat-form { display: flex; gap: 10px; position: relative; }
+.ghost-wrap { position: relative; flex: 1; min-width: 0; display: flex; }
+.ghost-wrap input { flex: 1; min-width: 0; background: transparent; position: relative; z-index: 1; }
+.ghost-wrap::before { content: ""; position: absolute; inset: 0; border-radius: 999px; background: #fff; }
+.ghost { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; white-space: pre; overflow: hidden;
+  pointer-events: none; color: transparent; border-radius: 999px; }
+.ghost .typed { color: transparent; }
+.ghost .tail { color: #9aa8c9; }
+.ghost .gap { margin-inline-start: .8em; }   /* on a wrapper: follows the box direction, not the name's */
+.ghost .swap { text-decoration: underline dotted 2px; text-decoration-color: #9aa8c9; text-underline-offset: 4px; }
+.ghost .key { margin-inline-start: .6em; padding: 0 .45em; border-radius: 6px; font-size: .75em; line-height: 1.6;
+  color: var(--soft); box-shadow: inset 0 0 0 1px var(--rim); }
+.examples .check { text-align: start; }
+.chip.pick { border: 0; cursor: pointer; font: inherit; font-weight: 700; color: var(--royal); box-shadow: inset 0 0 0 1.5px var(--rim); }
+.chip.pick:hover { background: var(--royal); color: #fff; }
